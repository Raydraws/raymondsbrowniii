<?xml version="1.0" encoding="utf-8"?>
<extension version="6.0" type="template" client="administrator" method="upgrade">
	<name>Power Admin</name>
	<version>1.0.0</version>
	<creationDate>Mar 2026</creationDate>
	<author>JoomShaper</author>
	<authorEmail>support@joomshaper.com</authorEmail>
	<copyright>(C) 2010 - 2026 JoomShaper. All rights reserved.</copyright>
	<license>http://www.gnu.org/licenses/gpl-2.0.html GPLv2 or later</license>
	<description>TPL_POWERADMIN_XML_DESCRIPTION</description>
	<files>
		<filename>component.php</filename>
		<filename>cpanel.php</filename>
		<filename>error.php</filename>
		<filename>error_full.php</filename>
		<filename>error_login.php</filename>
		<filename>favicon.ico</filename>
		<filename>index.php</filename>
		<filename>joomla.asset.json</filename>
		<filename>login.php</filename>
		<filename>templateDetails.xml</filename>
		<filename>template_preview.png</filename>
		<filename>template_thumbnail.png</filename>
		<folder>css</folder>
		<folder>fonts</folder>
		<folder>html</folder>
		<folder>images</folder>
		<folder>language</folder>
		<folder>Service</folder>
		<folder>js</folder>
	</files>
	<positions>
		<!-- used directly in the template -->
		<position>bottom</position>
		<position>debug</position>
		<position>menu</position>
		<position>quickmenu</position>
		<position>sidebar</position>
		<position>status</position>
		<position>title</position>
		<position>top</position>
		<position>toolbar</position>
		<!-- used directly in a component and included here so the position will appear in the list of available positions -->
		<position>cpanel</position>
		<position>icon</position>
		<position>login</position>
	</positions>
	<languages folder="language">
		<language tag="en-GB">en-GB/en-GB.tpl_poweradmin.ini</language>
		<language tag="en-GB">en-GB/en-GB.tpl_poweradmin.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="colors" label="TPL_POWERADMIN_COLORS_SETTINGS_LABEL">
				<field
					name="hue"
					type="color"
					label="TPL_POWERADMIN_COLORS_HUE"
					format="hue"
					control="slider"
					preview="true"
					saveFormat="hsl"
					default="hsl(207,61%,26%)"
				/>
				<field
					name="bg-light"
					type="color"
					label="TPL_POWERADMIN_COLORS_SETTINGS_BG_LIGHT_LABEL"
					default="#edf0f5"
					filter="color"
				/>
				<field
					name="text-dark"
					type="color"
					label="TPL_POWERADMIN_COLORS_SETTINGS_TEXT_DARK_LABEL"
					default="#495057"
					filter="color"
				/>
				<field
					name="text-light"
					type="color"
					label="TPL_POWERADMIN_COLORS_SETTINGS_TEXT_LIGHT_LABEL"
					default="#ffffff"
					filter="color"
				/>
				<field
					name="link-color"
					type="color"
					label="TPL_POWERADMIN_COLORS_SETTINGS_LINK_COLOR_LABEL"
					default="#198df8"
					filter="color"
				/>
				<field
					name="special-color"
					type="color"
					label="TPL_POWERADMIN_COLORS_SETTINGS_SPECIAL_COLOR_LABEL"
					default="#001b4c"
					filter="color"
				/>
				<field
					name="monochrome"
					type="radio"
					label="TPL_POWERADMIN_COLORS_SETTINGS_MONOCHROME_LABEL"
					layout="joomla.form.field.radio.switcher"
					default="0"
					>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="poweradmin_dark_mode"
					type="list"
					label="TPL_POWERADMIN_DARK_MODE_TEMPLATE_LABEL"
					default="-1"
					validate="options"
					>
					<option value="-1">TPL_POWERADMIN_DARK_MODE_TEMPLATE_OS_LABEL</option>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>

			<fieldset name="images" label="TPL_POWERADMIN_IMAGE_SETTINGS_LABEL">
				<field
					name="siteLogo"
					type="media"
					label="TPL_POWERADMIN_SITE_LOGO_LABEL"
				/>
				<field
					name="smallLogo"
					type="media"
					label="TPL_POWERADMIN_SITE_LOGO_SMALL_LABEL"
				/>
				<field
					name="loginLogo"
					type="media"
					label="TPL_POWERADMIN_LOGIN_LOGO_LABEL"
				 />
				<field
					name="altSiteLogo"
					type="text"
					label="TPL_POWERADMIN_ALTTEXT_SITE_LOGO_LABEL"
				/>
				<field
					name="altSmallLogo"
					type="text"
					label="TPL_POWERADMIN_ALTTEXT_SMALL_LOGO_LABEL"
				/>
				<field
					name="altLoginLogo"
					type="text"
					label="TPL_POWERADMIN_ALTTEXT_LOGIN_LOGO_LABEL"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
