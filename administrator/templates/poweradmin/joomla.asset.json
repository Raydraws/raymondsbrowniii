{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "poweradmin",
  "version": "4.0.0",
  "description": "Poweradmin is a Joomla 4 administrator template",
  "license": "GPL-2.0-or-later",
  "assets": [
    {
      "name": "template.poweradmin.base",
      "type": "preset",
      "dependencies": [
        "core",
		"bootstrap.js.bundle",
        "css-vars-ponyfill",
		"focus-visible",
        "template.poweradmin#script"
      ]
    },
    {
      "name": "template.poweradmin.ltr",
      "type": "preset",
      "dependencies": ["template.poweradmin.base"],
      "css": [
        "template.css",
        "user.css"
      ]
    },
    {
      "name": "template.atum.ltr",
      "type": "preset",
      "description": "Empty placeholder for Atum LTR preset (Compatibility)",
      "dependencies": []
    },
    {
      "name": "template.atum.rtl",
      "type": "preset",
      "description": "Empty placeholder for Atum RTL preset (Compatibility)",
      "dependencies": []
    },
    {
      "name": "template.atum.ltr",
      "type": "style",
      "description": "Empty placeholder for Atum LTR style (Compatibility)"
    },
    {
      "name": "template.atum.rtl",
      "type": "style",
      "description": "Empty placeholder for Atum RTL style (Compatibility)"
    },
    {
      "name": "template.active.language",
      "type": "style",
      "description": "Empty placeholder for active language style (Compatibility)"
    },
    {
      "name": "template.user",
      "type": "style",
      "description": "Empty placeholder for user style (Compatibility)"
    },
    {
      "name": "bootstrap.css",
      "type": "style",
      "css": [
        "bootstrap.min.css"
      ]
    },
    {
      "name": "fontawesome",
      "type": "style",
      "css": [
        "fontawesome.min.css"
      ]
    },
    {
      "name": "template.poweradmin",
      "description": "The file containing the javascript for this template.",
      "type": "script",
      "uri": "administrator/templates/poweradmin/js/template.js",
      "dependencies": [
        "core"
      ],
      "attributes": {
        "type": "module"
      }
    },
    {
      "name": "template.poweradmin.quickicon",
      "description": "The quickicon javascript for this template.",
      "type": "script",
      "uri": "administrator/templates/poweradmin/js/quickicon.js",
